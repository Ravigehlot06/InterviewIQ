# ============================================================
# InterviewIQ Backend Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-string

# --- Database ---
# Local Postgres example:
# postgresql://interviewiq_user:interviewiq_pass@localhost:5432/interviewiq
DATABASE_URL=postgresql://interviewiq_user:interviewiq_pass@localhost:5432/interviewiq

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --- Gemini (Generative AI) ---
# Create a key at https://aistudio.google.com/app/apikey
# If left blank, the app automatically runs in DEMO MODE
# (clearly labeled mock responses instead of real Gemini calls).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- CORS / URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=5
UPLOAD_FOLDER=uploads/resumes

# --- ML ---
ML_MODEL_PATH=ml/models/readiness_model.joblib
